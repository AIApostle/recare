# Server
PORT=8000
HOST=127.0.0.1
DEBUG=True
ENVIRONMENT=development

# Model Provider
# Supported: mock, openai, anthropic, bedrock, gemini
MODEL_PROVIDER=mock
MODEL_NAME=mock-agent-v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Database
DATABASE_URL=sqlite+aiosqlite:///./recare.db

# Security & CORS
CORS_ORIGINS=["chrome-extension://*", "http://localhost:3000", "http://127.0.0.1:3000"]
AUTO_APPROVE_LOW_RISK=True
REQUIRE_APPROVAL_HIGH_RISK=True
